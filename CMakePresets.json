{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 27 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON", "CMAKE_CXX_COMPILER": "mpicxx" }
    },

    { "name": "REL",  "inherits": "base", "displayName": "Base (Release)",  "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "DEV",  "inherits": "base", "displayName": "Base (Dev)",      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },

    { "name": "IREL",  "inherits": "base", "displayName": "Intel Base (Release)",  "cacheVariables": {"CMAKE_CXX_COMPILER": "mpiicx", "CMAKE_C_COMPILER": "mpiicc", "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "IDEV",  "inherits": "base", "displayName": "Intel Base (Dev)",      "cacheVariables": {"CMAKE_CXX_COMPILER": "mpiicx", "CMAKE_C_COMPILER": "mpiicc", "CMAKE_BUILD_TYPE": "Debug" } }
  ],

  "buildPresets": [
    { "name": "REL",      "configurePreset": "REL" },
    { "name": "DEV",      "configurePreset": "DEV" }
  ]
}